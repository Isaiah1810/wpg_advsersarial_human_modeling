// Strategies employed by drone
const int strat_RTB = 0; // Return to base
const int strat_TNI = 1; // track and ID
const int strat_SP = 2; // search poacher
const int strat_T2AOI = 3; // transit to area of interest
const int MaxStrat = 3; // max strat num

// invars for strategies
formula RTB_invar = (gotPoachID = 2) | (abort);
formula TNI_invar = (poachInLineOfSight) & (distance >= keepDistance);
formula SP_invar = !(gotPoachID=2) & location=2;
formula T2AOI_invar = !(gotPoachID=2);

// pre-cond for strategies
formula RTB_pre = location>0 & RTB_invar;
formula TNI_pre = !(gotPoachID=2) & TNI_invar;
formula SP_pre = !poachInLineOfSight & SP_invar;
formula T2AOI_pre = location<2 & T2AOI_invar;

// post-cond for strategies
formula RTB_post = (location=0);
formula TNI_post = (gotPoachID=2);
formula SP_post = poachInLineOfSight;
formula T2AOI_post = location=2;

//////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////
//// STRATEGIES
//////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////
module strategy_RTB
	[return_to_base] (strategy=strat_RTB & RTB_invar) -> 1 : true;
	[tau_tactic] (strategy=strat_RTB & !RTB_invar) -> 1 : true;
	// blocked
	[track_and_id] (strategy!=strat_RTB) -> 1 : true;
	[search_poacher] (strategy!=strat_RTB) -> 1 : true;
	[transit_to_aoi] (strategy!=strat_RTB) -> 1 : true;
	[change_flying_height] (strategy!=strat_RTB) -> 1 : true;
	[evade_gun_fire] (strategy!=strat_RTB) -> 1 : true;
endmodule

module strategy_TrackAndID
	keepDistance : [0 .. MaxDist] init 2;
	state : [0..6] init 0;
	[track_and_id] (strategy=strat_TNI & state=0 & TNI_invar) -> 1 : true;
	[tau_tactic] (strategy=strat_TNI & !TNI_invar) -> 1 : true;
	// blocked
	[return_to_base] (strategy!=strat_TNI) -> 1 : true;
	[search_poacher] (strategy!=strat_TNI) -> 1 : true;
	[transit_to_aoi] (strategy!=strat_TNI) -> 1 : true;
	[change_flying_height] (strategy!=strat_TNI) -> 1 : true;
	[evade_gun_fire] (strategy!=strat_TNI) -> 1 : true;
endmodule

module strategy_SearchPoacher
	[search_poacher] (strategy=strat_SP & SP_invar) -> 1 : true;
	[tau_tactic] (strategy=strat_SP & !SP_invar) -> 1 : true;
	// blocked
	[return_to_base] (strategy!=strat_SP) -> 1 : true;
	[track_and_id] (strategy!=strat_SP) -> 1 : true;
	[transit_to_aoi] (strategy!=strat_SP) -> 1 : true;
	[change_flying_height] (strategy!=strat_SP) -> 1 : true;
	[evade_gun_fire] (strategy!=strat_SP) -> 1 : true;
endmodule

module strategy_Transit_To_AOI
	[transit_to_aoi] (strategy=strat_T2AOI & T2AOI_invar) -> 1 : true;
	[tau_tactic] (strategy=strat_T2AOI & !T2AOI_invar) -> 1 : true;
	// blocked
	[return_to_base] (strategy!=strat_T2AOI) -> 1 : true;
	[track_and_id] (strategy!=strat_T2AOI) -> 1 : true;
	[search_poacher] (strategy!=strat_T2AOI) -> 1 : true;
	[change_flying_height] (strategy!=strat_T2AOI) -> 1 : true;
	[evade_gun_fire] (strategy!=strat_T2AOI) -> 1 : true;
endmodule
